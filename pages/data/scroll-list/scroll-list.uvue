<template>
   <uvx-page>
      <view class="uvx-page-demo scroll-list-demo">
         <!-- 基础使用 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="基础使用"></uvx-text>
            </view>
            <uvx-scroll-list
               indicator-color="#fff0f0"
               indicator-active-color="#f56c6c"
               @left="handleLeft"
               @right="handleRight"
            >
               <view class="scroll-list-demo__goods-row">
                  <view
                     v-for="(item, index) in GOODS_LIST"
                     :key="index"
                     class="scroll-list-demo__goods-item"
                  >
                     <image
                        class="scroll-list-demo__goods-image"
                        :src="GOODS_BASE_URL + item.thumbnail"
                        mode="aspectFill"
                     ></image>
                     <text class="scroll-list-demo__goods-price">￥{{ item.price }}</text>
                  </view>
                  <view
                     class="scroll-list-demo__more"
                     @tap="handleShowMore"
                  >
                     <text class="scroll-list-demo__more-text">查看更多</text>
                     <uvx-icon
                        name="arrow-leftward"
                        color="#f56c6c"
                        :size="12"
                     ></uvx-icon>
                  </view>
               </view>
            </uvx-scroll-list>
         </view>

         <!-- 多菜单扩展 -->
         <view class="uvx-demo-block">
