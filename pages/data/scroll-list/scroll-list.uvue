            <uvx-scroll-list>
               <view class="scroll-list-demo__menu-list">
                  <view
                     v-for="(row, rowIndex) in MENU_LIST"
                     :key="rowIndex"
                     class="scroll-list-demo__menu-row"
                  >
                     <view
                        v-for="(item, itemIndex) in row"
                        :key="itemIndex"
                        class="scroll-list-demo__menu-item"
                        :class="itemIndex == row.length - 1 ? 'scroll-list-demo__menu-item-last' : ''"
                     >
                        <image
                           class="scroll-list-demo__menu-image"
                           :src="MENU_BASE_URL + item.icon"
                           mode="aspectFill"
                        ></image>
                        <text class="scroll-list-demo__menu-text">{{ item.name }}</text>
                     </view>
                  </view>
               </view>
            </uvx-scroll-list>
         </view>
      </view>
   </uvx-page>
</template>

