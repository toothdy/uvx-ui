      { name: "造点新货", icon: "13.png" },
      { name: "土货鲜食", icon: "14.png" },
   ],
];

/**
 * 处理查看更多点击
 * @returns null
 */
const handleShowMore = (): void => {
   console.log("scroll-list show more");
};

/**
 * 处理左边界事件
 * @returns null
 */
const handleLeft = (): void => {
   console.log("scroll-list left");
};

/**
 * 处理右边界事件
 * @returns null
 */
const handleRight = (): void => {
   console.log("scroll-list right");
