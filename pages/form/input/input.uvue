<template>
   <uvx-page>
      <view class="uvx-page-demo">
         <!-- 基础使用 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="基础使用"></uvx-text>
            </view>
            <uvx-input v-model="value" placeholder="请输入内容" @change="handleChange"></uvx-input>
         </view>
         <!-- 可清空内容 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="可清空内容"></uvx-text>
            </view>
            <uvx-input placeholder="请输入内容" clearable></uvx-input>
         </view>
         <!-- 数字键盘 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="数字键盘"></uvx-text>
            </view>
            <uvx-input placeholder="请输入内容" type="number" clearable></uvx-input>
         </view>
         <!-- 密码类型 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="密码类型"></uvx-text>
            </view>
            <uvx-input placeholder="请输入内容" password></uvx-input>
         </view>
         <!-- 显示下划线 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="显示下划线"></uvx-text>
            </view>
            <uvx-input placeholder="请输入内容" border="bottom" clearable></uvx-input>
         </view>
         <!-- 禁用状态 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="禁用状态"></uvx-text>
            </view>
            <uvx-input placeholder="禁用状态" disabled></uvx-input>
         </view>
         <!-- 圆形 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="圆形"></uvx-text>
            </view>
            <uvx-input placeholder="请输入内容" shape="circle"></uvx-input>
         </view>
         <!-- 前后图标 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="前后图标"></uvx-text>
            </view>
            <uvx-input
               placeholder="前置图标"
               prefix-icon="search"
               prefix-icon-style="color: #909399"
            ></uvx-input>
            <view class="input-demo-gap">
               <uvx-input
                  placeholder="后置图标"
                  suffix-icon="map-fill"
                  suffix-icon-style="color: #909399"
               ></uvx-input>
            </view>
         </view>
         <!-- 前后插槽 -->
         <view class="uvx-demo-block">
            <view class="uvx-demo-block__title">
               <uvx-text type="main" text="前后插槽"></uvx-text>
            </view>
            <uvx-input placeholder="前置插槽">
               <template #prefix>
                  <uvx-text
                     type="main"
                     text="http://"
                     margin="0 3px 0 0"
                     u-style="flex: none; width: auto;"
                  ></uvx-text>
               </template>
            </uvx-input>
            <view class="input-demo-gap">
            <uvx-input placeholder="后置插槽">
               <template #suffix>
                     <uvx-code
                        ref="uCode"
                        :seconds="20"
                        change-text="XS重新获取"
                        @change="handleCodeChange"
                     ></uvx-code>
                     <uvx-button
                        :text="codeTips"
                        type="success"
                        size="mini"
                        @click="handleCodeClick"
                     ></uvx-button>
               </template>
               </uvx-input>
            </view>
         </view>
      </view>
   </uvx-page>
</template>

<script lang="uts" setup>
// 双向绑定的输入内容
const value = ref("内容");
// 插槽验证码提示
const codeTips = ref("获取验证码");
// 插槽验证码组件实例
const uCode = ref<UvxCodeComponentPublicInstance | null>(null);

/**
 * 监听输入内容变化
 * @param value 当前输入内容
 * @returns null
 */
const handleChange = (value: string): void => {
   console.log("输入内容：", value);
};

/**
 * 展示后缀按钮点击效果
 * @returns null
 */
const handleCodeChange = (value: string): void => {
   codeTips.value = value;
};

/**
 * 开始插槽验证码倒计时
 * @returns null
 */
const handleCodeClick = (): void => {
   if (uCode.value != null && uCode.value.canGetCode) uCode.value.start();
};
</script>

<style lang="scss">
@import "@/common/demo.scss";

// 同一区块内两行示例的间距，与 TS 演示保持一致
.input-demo-gap {
   margin-top: 15px;
}
</style>
