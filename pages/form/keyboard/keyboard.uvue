<template>
   <uvx-page>
      <view class="keyboard-demo">
         <!-- 键盘演示入口 -->
         <uvx-cell-group>
            <uvx-cell
               v-for="(item, index) in demoItems"
               :key="index"
               :title="item.title"
               :is-link="true"
               @click="handleOpenKeyboard(index)"
            >
               <template #icon>
                  <image class="uv-cell-icon" :src="item.iconUrl" mode="widthFix"></image>
               </template>
            </uvx-cell>
         </uvx-cell-group>

         <!-- 通用键盘实例 -->
         <uvx-keyboard
            ref="uKeyboard"
            :mode="keyboardConfig.mode"
            :dot-disabled="keyboardConfig.dotDisabled"
            :random="keyboardConfig.random"
            @close="handleClose"
            @cancel="handleCancel"
            @confirm="handleConfirm"
            @change="handleChange"
            @backspace="handleBackspace"
         ></uvx-keyboard>

         <!-- 自定义车牌键盘实例 -->
         <uvx-keyboard
            ref="uCarKeyboard"
            mode="car"
            :uSwitchKey="true"
            :dis-keys="DISABLED_CAR_KEYS"
            @change="handleChange"
            @confirm="handleConfirm"
            @change-car-input-mode="handleCarModeChange"
         >
            <template #abc>
               <text class="keyboard-demo__switch-text">
                  {{ isAlphabetMode ? "省份" : "ABC" }}
               </text>
            </template>
         </uvx-keyboard>
      </view>
   </uvx-page>
</template>

<script lang="uts" setup>
import type {
   Key,
   Mode,
} from "@/uni_modules/uvx-ui/components/uvx-keyboard/types/index.uts";

type KeyboardDemoItem = {
   title: string;
   iconUrl: string;
};

type KeyboardDemoConfig = {
   mode: Mode;
   dotDisabled: boolean;
   random: boolean;
};

// 自定义车牌键盘禁用项
const DISABLED_CAR_KEYS: Key[] = ["京", 2, "Q", "X"];
// 演示入口
const demoItems: KeyboardDemoItem[] = [
   {
      title: "车牌号键盘",
      iconUrl: "https://cdn.uviewui.com/uview/demo/keyboard/car.png",
   },
   {
      title: "车牌号键盘切换键自定义+禁用按键",
      iconUrl: "https://cdn.uviewui.com/uview/demo/keyboard/car.png",
   },
   {
      title: "数字键盘",
      iconUrl: "https://cdn.uviewui.com/uview/demo/keyboard/number.png",
   },
   {
      title: "身份证键盘",
      iconUrl: "https://cdn.uviewui.com/uview/demo/keyboard/IdCard.png",
   },
   {
      title: "隐藏键盘\".\"符号",
      iconUrl: "https://cdn.uviewui.com/uview/demo/keyboard/dot.png",
   },
   {
      title: "打乱键盘按键的顺序",
      iconUrl: "https://cdn.uviewui.com/uview/demo/keyboard/order.png",
   },
];
// 通用键盘配置
const keyboardConfig = ref<KeyboardDemoConfig>({
   mode: "car",
   dotDisabled: false,
   random: false,
});
// 当前输入内容
const inputValue = ref("");
// 自定义车牌键盘是否为字母数字模式
const isAlphabetMode = ref(false);
// 通用键盘实例
const uKeyboard = ref<UvxKeyboardComponentPublicInstance | null>(null);
// 自定义车牌键盘实例
const uCarKeyboard = ref<UvxKeyboardComponentPublicInstance | null>(null);

/**
 * 打开指定键盘
 * @param index 演示入口索引
 * @returns null
 */
const handleOpenKeyboard = (index: number): void => {
   keyboardConfig.value = {
      mode: "car",
      dotDisabled: false,
      random: false,
   } as KeyboardDemoConfig;
   inputValue.value = "";
   if (index == 1) {
      uCarKeyboard.value?.open();
      return;
   }
   if (index == 2) keyboardConfig.value.mode = "number";
   else if (index == 3) keyboardConfig.value.mode = "card";
   else if (index == 4) {
      keyboardConfig.value.mode = "number";
      keyboardConfig.value.dotDisabled = true;
   } else if (index == 5) {
      keyboardConfig.value.mode = "number";
      keyboardConfig.value.random = true;
   }
   uKeyboard.value?.open();
};

/**
 * 记录键盘输入
 * @param value 按键值
 * @returns null
 */
const handleChange = (value: Key): void => {
   console.log("change", value);
   inputValue.value += value.toString();
};

/**
 * 记录键盘关闭
 * @returns null
 */
const handleClose = (): void => {
   console.log("键盘关闭");
};

/**
 * 记录取消操作
 * @returns null
 */
const handleCancel = (): void => {
   console.log("cancel");
};

/**
 * 记录确认操作
 * @returns null
 */
const handleConfirm = (): void => {
   console.log("confirm");
};

/**
 * 删除最后一个输入字符
 * @returns null
 */
const handleBackspace = (): void => {
   inputValue.value = inputValue.value.slice(0, -1);
};

/**
 * 同步自定义车牌键盘模式
 * @param value 是否为字母数字模式
 * @returns null
 */
const handleCarModeChange = (value: boolean): void => {
   isAlphabetMode.value = value;
};
</script>

<style lang="scss">
@import "@/common/demo.scss";

// 演示页沿用 TS 版的无额外内边距列表布局
.keyboard-demo {
   padding: 0;

   // 自定义车牌切换键文字
   &__switch-text {
      color: var(--uvx-text-main);
      font-size: 14px;
   }
}
</style>
