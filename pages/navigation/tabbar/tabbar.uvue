<script lang="uts" setup>
import type { Value } from "@/uni_modules/uvx-ui/components/uvx-tabbar/types/index.uts";

// 页面容器实例
const uPage = ref<UvxPageComponentPublicInstance | null>(null);
// 基础功能选中项
const value1 = ref<Value>(0);
// 徽标案例选中项
const value2 = ref<Value>(1);
// 名称匹配案例选中项
const value3 = ref<Value>("play-right");
// 自定义案例选中项
const value4 = ref<Value>(0);
// 拦截案例选中项
const value5 = ref<Value>(0);
// 无边框案例选中项
const value6 = ref<Value>(3);
// 图标大小案例选中项
const value7 = ref<Value>(3);
// 固定定位案例选中项
const value8 = ref<Value>(0);
// 凸起按钮案例选中项
const value9 = ref<Value>(0);

/**
 * 更新基础功能选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange1 = (value: Value): void => {
   value1.value = value;
};

/**
 * 更新徽标案例选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange2 = (value: Value): void => {
   value2.value = value;
};

/**
 * 更新名称匹配案例选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange3 = (value: Value): void => {
   value3.value = value;
};

/**
 * 更新自定义案例选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange4 = (value: Value): void => {
   value4.value = value;
};

/**
 * 拦截需要登录的导航项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange5 = (value: Value): void => {
   if (typeof value == "number" && value == 1) {
      uPage.value?.toast({ message: "请您先登录", icon: false });
      return;
   }
   value5.value = value;
};

/**
 * 更新无边框案例选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange6 = (value: Value): void => {
   value6.value = value;
};

/**
 * 更新图标大小案例选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange7 = (value: Value): void => {
   value7.value = value;
};

/**
 * 更新固定定位案例选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange8 = (value: Value): void => {
   value8.value = value;
};

/**
 * 更新凸起按钮案例选中项
 * @param value 导航项名称或索引
 * @returns null
 */
const handleChange9 = (value: Value): void => {
   value9.value = value;
};

/**
 * 输出导航项点击值
 * @param value 导航项名称或索引
 * @returns null
 */
const handleItemClick = (value: Value): void => {
   console.log("点击导航项：", value);
};
</script>

