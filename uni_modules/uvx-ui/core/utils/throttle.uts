/**
 * 节流
 */
class Throttle {
	private timer: number = 0;
	private flag: boolean = false;
	
	/**
	 * 节流函数
	 * @param func 要执行的回调函数
	 * @param wait 延时的时间（默认500ms）
	 * @param immediate 是否立即执行（默认false）
	 * @description 在一定时间内，只能触发一次
	 */
	run(func: () => void, wait: number = 500, immediate: boolean = false): void {
		if (immediate) {
			if (!this.flag) {
				this.flag = true;
				// 立即执行
				func();
				this.timer = setTimeout(() => {
					this.flag = false;
				}, wait);
			}
		} else if (!this.flag) {
			this.flag = true;
			// 延时执行
			this.timer = setTimeout(() => {
				this.flag = false;
				func();
			}, wait);
		}
	}
}

export default new Throttle();
