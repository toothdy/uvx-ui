const EXPIRES_SUFFIX = "_deadtime";

/**
 * 本地存储工具
 * @description 封装 uni 同步存储 API，支持设置过期时间
 */
class Storage {
	/**
	 * 读取存储值
	 * @param key 存储键
	 * @returns 存储值，不存在时返回 null
	 */
	get(key: string): any | null {
		const value = uni.getStorageSync(key);
		// uni-app x：读取不存在的 key 会返回空字符串 ""（而非 null），
		// 统一规整为 null，避免调用方 `as number` 等强转时抛 ClassCastException
		if (value == null || value == '') {
			return null;
		}
		return value;
	}

	/**
	 * 写入存储值
	 * @param key 存储键
	 * @param value 存储值
	 * @param expires 过期秒数，> 0 时写入过期时间，<= 0 表示永久有效
	 */
	set(key: string, value: any, expires: number): void {
		uni.setStorageSync(key, value);
		if (expires > 0) {
			const expireTime = new Date().getTime() + expires * 1000;
			uni.setStorageSync(`${key}${EXPIRES_SUFFIX}`, expireTime);
		}
	}

	/**
	 * 判断指定键是否已过期
	 * @param key 存储键
	 * @returns 已过期或无过期记录时返回 true
	 */
	isExpired(key: string): boolean {
		const value = this.get(`${key}${EXPIRES_SUFFIX}`) as number | null;
		if (value == null) {
			return true;
		}
		return value - new Date().getTime() <= 0;
	}

	/**
	 * 移除指定键及其过期记录
	 * @param key 存储键
	 */
	remove(key: string): void {
		uni.removeStorageSync(key);
		uni.removeStorageSync(`${key}${EXPIRES_SUFFIX}`);
	}

	/**
	 * 清空所有存储
	 */
	clear(): void {
		uni.clearStorageSync();
	}
}

/**
 * 全局存储实例
 */
export const storage = new Storage();
