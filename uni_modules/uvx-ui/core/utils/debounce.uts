/**
 * 防抖
 */
class Debounce {
	private timeout: number = 0;
	
	/**
	 * 防抖函数
	 * @param func 要执行的回调函数
	 * @param wait 延时的时间（默认500ms）
	 * @param immediate 是否立即执行（默认false）
	 * @description 一定时间内，只有最后一次操作，再过wait毫秒后才执行函数
	 */
	run(func: () => void, wait: number = 500, immediate: boolean = false): void {
		// 清除定时器
		if (this.timeout != 0) {
			clearTimeout(this.timeout);
		}
		
		// 立即执行
		if (immediate) {
			const callNow = this.timeout == 0;
			this.timeout = setTimeout(() => {
				this.timeout = 0;
			}, wait);
			if (callNow) {
				func();
			}
		} else {
			// 延时执行
			this.timeout = setTimeout(() => {
				func();
			}, wait);
		}
	}
}

export default new Debounce();