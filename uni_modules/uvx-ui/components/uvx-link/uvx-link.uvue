<template>
	<text
		class="uvx-link"
		:class="[uClass]"
		:style="linkStyle"
		@tap.stop="openLink"
	>
		{{ text }}
	</text>
	<uvx-toast ref="uToast"></uvx-toast>
</template>

<script lang="uts" setup>
/**
 * uvx-link 超链接
 * @description 超链接组件，APP 内置浏览器打开，H5 新窗口打开，小程序复制链接到剪贴板
 * @tutorial https://www.uvxui.cn/components/link.html
 * @property {String} color 文字颜色（默认跟随主题主色）
 * @property {String | Number} fontSize 字体大小，单位 px（默认 15）
 * @property {Boolean} underLine 是否显示下划线（默认 false）
 * @property {String} href 跳转链接，需带 http(s)://
 * @property {String} mpTips 小程序复制后的提示语（默认"链接已复制，请在浏览器打开"）
 * @property {String} lineColor 下划线颜色，默认同 color
 * @property {String} text 超链接文字
 * @property {String} uStyle 自定义样式
 * @property {String} uClass 自定义类名
 *
 * @event {Function} click 点击触发
 */

import { $uvx } from '../../index.uts';
import type { Props, Emits } from './types/index.uts';

defineOptions({ name: 'uvx-link', options: { virtualHost: true }, externalClasses: ['u-class'] });

/**
 * 属性
 */
const props = withDefaults(defineProps<Props>(), {
	color: '',
	fontSize: 15,
	underLine: false,
	href: '',
	mpTips: '链接已复制，请在浏览器打开',
	lineColor: '',
	text: '',
	uStyle: "",
	uClass: ''
});

/**
 * 事件
 */
const emit = defineEmits<Emits>();

// 组件 Toast 实例
const uToast = ref<UvxToastComponentPublicInstance | null>(null);

/**
 * 链接样式：字号、行高、颜色、下划线
 * color 为空时由 SCSS 主题变量控制
 * @returns UTSJSONObject
 */
const linkStyle = computed(() => {
	const style : UTSJSONObject = {};
	style.set('fontSize', $uvx.format.unit(props.fontSize));
	const fs = parseFloat($uvx.format.unit(props.fontSize));
	style.set('lineHeight', $uvx.format.unit(isNaN(fs) ? 17 : fs + 2));
	
	if (!$uvx.string.empty(props.color)) {
		style.set('color', props.color);
	}
	
	style.set('textDecorationLine', props.underLine ? 'underline' : 'none');
	return $uvx.object.deepMerge(style, $uvx.style.parse(props.uStyle));
});

/**
 * 点击打开链接
 * APP：调用内置浏览器打开
 * H5：新窗口打开
 * MP：复制到剪贴板并提示
 * @returns null
 */
const openLink = () => {
	if (!$uvx.string.empty(props.href)) {
		// #ifdef WEB
		window.open(props.href);
		// #endif
		// #ifdef MP
		uni.setClipboardData({
			data: props.href,
			success: () => {
				uni.hideToast();
				uToast.value?.show({ message: props.mpTips, type: "success" });
			}
		});
		// #endif
		// #ifdef APP
		uni.setClipboardData({
			showToast: false,
			data: props.href,
			success: () => {
				uToast.value?.show({ message: props.mpTips, type: "success" });
			}
		});
		// #endif
	}
	emit('click');
};
</script>

<style lang="scss">
	.uvx-link {
		color: var(--uvx-primary);
	}
</style>
