<template>
   <!-- 间隔槽主体 -->
   <view class="uvx-gap" :style="gapStyle"></view>
</template>

<script lang="uts" setup>
/**
 * uvx-gap 间隔槽
 * @description 用于在内容块之间创建统一的间隔区域。
 * @tutorial https://www.uvxui.cn/components/gap.html
 * @property {String} bgColor 背景颜色，为空时使用页面背景色
 * @property {String | Number} height 间隔槽高度，单位 px（默认 20）
 * @property {String | Number} marginTop 与前一个组件的距离，单位 px（默认 0）
 * @property {String | Number} marginBottom 与后一个组件的距离，单位 px（默认 0）
 * @property {String} uStyle 根节点自定义样式
 * @example <uvx-gap height="40" bg-color="#2979ff"></uvx-gap>
 */

import { $uvx } from "../../index.uts";
import type { Props } from "./types/index.uts";

defineOptions({ name: "uvx-gap", options: { virtualHost: true } });

const props = withDefaults(defineProps<Props>(), {
   bgColor: "",
   height: 20,
   marginTop: 0,
   marginBottom: 0,
   uStyle: "",
});

/**
 * 间隔槽样式
 * @returns UTSJSONObject
 */
const gapStyle = computed((): UTSJSONObject => {
   const style: UTSJSONObject = {
      "height": $uvx.format.unit(props.height),
      "margin-top": $uvx.format.unit(props.marginTop),
      "margin-bottom": $uvx.format.unit(props.marginBottom),
   };
   if (!$uvx.string.empty(props.bgColor)) {
      style.set("background-color", props.bgColor);
   }
   if ($uvx.string.empty(props.uStyle)) return style;
   return $uvx.object.deepMerge(style, $uvx.style.parse(props.uStyle));
});
</script>

<style lang="scss">
// 间隔槽主体
.uvx-gap {
   width: 100%;
   flex-shrink: 0;
   background-color: var(--uvx-page);
}
</style>
