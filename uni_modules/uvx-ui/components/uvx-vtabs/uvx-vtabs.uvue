   align-items: center;
   justify-content: center;
   box-sizing: border-box;
   width: 100%;
   height: 54px;
   padding: 0 14px 0 10px;
   flex-shrink: 0;
   overflow: visible;
}

// 左侧标签按压态
.uvx-vtabs__bar-item--hover {
   background-color: var(--uvx-hover);
}

// 左侧标签激活态
.uvx-vtabs__bar-item--active {
   background-color: var(--uvx-container);
}

// 左侧标签禁用态
.uvx-vtabs__bar-item--disabled {
   background-color: var(--uvx-page);
}

// 激活指示线
.uvx-vtabs__bar-line {
   position: absolute;
   top: 0;
   bottom: 0;
   left: 0;
   z-index: 1;
   width: 2px;
   background-color: var(--uvx-primary);
}

// 标签文字
.uvx-vtabs__bar-text {
   flex: 1;
   min-width: 0;
   color: var(--uvx-text-content);
   font-size: 14px;
   line-height: 1.2em;
   text-align: center;
}

// 激活标签文字
.uvx-vtabs__bar-text--active {
   color: var(--uvx-primary);
}

// 普通标签文字
.uvx-vtabs__bar-text--inactive {
   color: var(--uvx-text-content);
}

// 禁用标签文字
.uvx-vtabs__bar-text--disabled {
   color: var(--uvx-disabled);
}

// 标签徽标容器
.uvx-vtabs__bar-badge {
   position: absolute;
   top: 4px;
   right: 6px;
   z-index: 2;
   display: flex;
   flex-direction: row;
   align-items: center;
   justify-content: center;
   min-width: 18px;
   min-height: 18px;
   overflow: visible;
}

// 右侧内容区域
.uvx-vtabs__content {
   display: flex;
   flex: 1;
   min-width: 0;
   overflow: hidden;
   background-color: var(--uvx-container);
}

// 右侧内容容器
.uvx-vtabs__content-inner {
   display: flex;
   flex-direction: column;
   width: 100%;
   overflow: visible;
}
</style>
