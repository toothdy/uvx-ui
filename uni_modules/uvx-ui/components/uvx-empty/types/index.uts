/** 内容为空预置状态 */
export type Mode = "car" | "page" | "search" | "address" | "wifi-off" | "order"
   | "coupon" | "favor" | "permission" | "history" | "news" | "message"
   | "list" | "data" | "comment";

/** 内容为空属性 */
export type Props = {
   /** 自定义字体图标名、图片路径或 base64 */
   icon: string;
   /** 自定义提示文字 */
   text: string;
   /** 提示文字颜色 */
   textColor: string;
   /** 提示文字大小 */
   textSize: string | number;
   /** 字体图标颜色 */
   iconColor: string;
   /** 字体图标大小 */
   iconSize: string | number;
   /** 预置状态 */
   mode: Mode;
   /** 自定义图片宽度 */
   width: string | number;
   /** 自定义图片高度 */
   height: string | number;
   /** 是否显示组件 */
   show: boolean;
   /** 与上一个元素的距离 */
   marginTop: string | number;
   /** 根节点自定义样式 */
   uStyle: string;
   /** 根节点自定义类名 */
   uClass: string;
};
