export type Mode = "number" | "card" | "car";
export type Key = string | number;

export type Props = {
   mode: Mode;
   dotDisabled: boolean;
   tooltip: boolean;
   showTips: boolean;
   tips: string;
   showCancel: boolean;
   showConfirm: boolean;
   random: boolean;
   safeAreaInsetBottom: boolean;
   closeOnClickOverlay: boolean;
   closeOnClickConfirm: boolean;
   overlay: boolean;
   zIndex: string | number;
   cancelText: string;
   confirmText: string;
   autoChange: boolean;
   disKeys: Key[];
   uSwitchKey: boolean;
   uStyle: string;
   uClass: string;
};

export type Emits = {
   close: [];
   change: [value: Key];
   confirm: [];
   cancel: [];
   backspace: [];
   changeCarInputMode: [isAlphabet: boolean];
};
