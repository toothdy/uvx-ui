import type { ErrorCorrectLevel, Matrix, Options } from "./types/index.uts";

type RsBlock = { totalCount: number; dataCount: number; };
type InternalMatrix = Array<Array<boolean | null>>;

const MODE_8BIT_BYTE: number = 4;
const PAD0: number = 236;
const PAD1: number = 17;
const G15: number = 1335;
const G18: number = 7973;
const G15_MASK: number = 21522;
const PATTERN_POSITION_TABLE: number[][] = [
   [], [6, 18], [6, 22], [6, 26], [6, 30], [6, 34], [6, 22, 38], [6, 24, 42], [6, 26, 46], [6, 28, 50],
