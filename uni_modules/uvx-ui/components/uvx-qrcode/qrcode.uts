];

const EXP_TABLE: number[] = [];
const LOG_TABLE: number[] = [];
for (let index = 0; index < 8; index++) EXP_TABLE[index] = 1 << index;
for (let index = 8; index < 256; index++) EXP_TABLE[index] = EXP_TABLE[index - 4] ^ EXP_TABLE[index - 5] ^ EXP_TABLE[index - 6] ^ EXP_TABLE[index - 8];
for (let index = 0; index < 255; index++) LOG_TABLE[EXP_TABLE[index]] = index;

/** 规范化纠错等级。 */
export const normalizeErrorLevel = (value: ErrorCorrectLevel | null): ErrorCorrectLevel => {
   if (value == "L" || value == "M" || value == "Q" || value == "H") return value;
   return "H";
};

/** 将字符串编码成 UTF-8 字节。 */
const toUtf8Bytes = (value: string): number[] => {
   const bytes: number[] = [];
   for (let index = 0; index < value.length; index++) {
      const code = value.charCodeAt(index);
      if (code < 0x80) bytes.push(code);
      else if (code < 0x800) bytes.push(0xc0 | (code >> 6), 0x80 | (code & 0x3f));
      else bytes.push(0xe0 | (code >> 12), 0x80 | ((code >> 6) & 0x3f), 0x80 | (code & 0x3f));
   }
   return bytes;
};

/** 获取有限域指数。 */
const gexp = (value: number): number => {
   let current = value;
   while (current < 0) current += 255;
   while (current >= 256) current -= 255;
   return EXP_TABLE[current];
};

/** 获取有限域对数。 */
const glog = (value: number): number => {
   if (value < 1) throw new Error("glog requires a positive value");
   return LOG_TABLE[value];
};

class BitBuffer {
   buffer: number[] = [];
   length: number = 0;

   /** 写入固定长度的整数位。 */
   put(value: number, bitCount: number): void {
      for (let index = 0; index < bitCount; index++) this.putBit(((value >> (bitCount - index - 1)) & 1) == 1);
   }

   /** 写入单个位。 */
   putBit(value: boolean): void {
      const index = Math.floor(this.length / 8);
      while (this.buffer.length <= index) this.buffer.push(0);
      if (value) this.buffer[index] |= 0x80 >> (this.length % 8);
      this.length++;
   }
}

/** 获取版本对应的 RS 数据块。 */
const getRsBlocks = (version: number, level: ErrorCorrectLevel): RsBlock[] => {
   const levelIndex = level == "L" ? 0 : level == "M" ? 1 : level == "Q" ? 2 : 3;
   const row = RS_BLOCK_TABLE[(version - 1) * 4 + levelIndex];
   if (row == null) throw new Error("unsupported QR version");
   const blocks: RsBlock[] = [];
   for (let index = 0; index < row.length; index += 3) for (let count = 0; count < row[index]; count++) blocks.push({ totalCount: row[index + 1], dataCount: row[index + 2] });
   return blocks;
};

/** 生成 RS 纠错多项式。 */
const getErrorPolynomial = (length: number): number[] => {
   let result: number[] = [1];
   for (let index = 0; index < length; index++) {
      const next: number[] = [];
      for (let position = 0; position < result.length + 1; position++) next.push(0);
      for (let position = 0; position < result.length; position++) {
         next[position] ^= result[position];
         next[position + 1] ^= result[position] == 0 ? 0 : gexp(glog(result[position]) + index);
      }
      result = next;
   }
   return result;
};

/** 生成多项式余数。 */
const modPolynomial = (source: number[], divisor: number[]): number[] => {
   let offset = 0;
   while (offset < source.length && source[offset] == 0) offset++;
   if (source.length - offset < divisor.length) return source.slice(offset);
   const result = source.slice(offset);
   const ratio = glog(result[0]) - glog(divisor[0]);
   for (let index = 0; index < divisor.length; index++) if (divisor[index] != 0) result[index] ^= gexp(glog(divisor[index]) + ratio);
   return modPolynomial(result, divisor);
};

/** 生成交错后的数据和纠错字节。 */
const createBytes = (buffer: BitBuffer, blocks: RsBlock[]): number[] => {
   let dataCount = 0;
   for (const block of blocks) dataCount += block.dataCount;
   if (buffer.length > dataCount * 8) throw new Error("code length overflow");
   if (buffer.length + 4 <= dataCount * 8) buffer.put(0, 4);
   while (buffer.length % 8 != 0) buffer.putBit(false);
   while (buffer.length < dataCount * 8) buffer.put(buffer.length % 16 == 0 ? PAD0 : PAD1, 8);
   const dataBlocks: number[][] = [];
   const errorBlocks: number[][] = [];
   let offset = 0;
   let maxData = 0;
   let maxError = 0;
   for (const block of blocks) {
      const data = buffer.buffer.slice(offset, offset + block.dataCount);
      offset += block.dataCount;
      const errorCount = block.totalCount - block.dataCount;
      const raw = data.slice();
      for (let index = 0; index < errorCount; index++) raw.push(0);
      const remainder = modPolynomial(raw, getErrorPolynomial(errorCount));
      const errors: number[] = [];
      for (let index = 0; index < errorCount; index++) {
         const remainderIndex = index + remainder.length - errorCount;
         errors.push(remainderIndex >= 0 ? remainder[remainderIndex] : 0);
      }
      dataBlocks.push(data); errorBlocks.push(errors);
      maxData = Math.max(maxData, data.length); maxError = Math.max(maxError, errors.length);
   }
   const result: number[] = [];
   for (let index = 0; index < maxData; index++) for (const block of dataBlocks) if (index < block.length) result.push(block[index]);
   for (let index = 0; index < maxError; index++) for (const block of errorBlocks) if (index < block.length) result.push(block[index]);
   return result;
};

/** 计算整数的位数。 */
const getBchDigit = (value: number): number => {
   let current = value;
   let digit = 0;
   while (current != 0) { digit++; current >>>= 1; }
   return digit;
};

/** 生成 BCH 编码。 */
const getBch = (value: number, generator: number, shift: number): number => {
   let current = value << shift;
   const generatorBits = getBchDigit(generator);
   while (getBchDigit(current) - generatorBits >= 0) current ^= generator << (getBchDigit(current) - generatorBits);
   return (value << shift) | current;
};

/** 应用掩码。 */
const getMask = (mask: number, row: number, column: number): boolean => {
   if (mask == 0) return (row + column) % 2 == 0;
   if (mask == 1) return row % 2 == 0;
   if (mask == 2) return column % 3 == 0;
   if (mask == 3) return (row + column) % 3 == 0;
   if (mask == 4) return (Math.floor(row / 2) + Math.floor(column / 3)) % 2 == 0;
   if (mask == 5) return row * column % 2 + row * column % 3 == 0;
   if (mask == 6) return (row * column % 2 + row * column % 3) % 2 == 0;
   return (row * column % 3 + (row + column) % 2) % 2 == 0;
};

/** 创建空矩阵。 */
const createEmptyMatrix = (size: number): InternalMatrix => {
   const matrix: InternalMatrix = [];
   for (let row = 0; row < size; row++) {
      const line: Array<boolean | null> = [];
      for (let column = 0; column < size; column++) line.push(null);
      matrix.push(line);
   }
   return matrix;
};

/** 写入定位、对齐和时序图案。 */
const setupPatterns = (matrix: InternalMatrix, version: number): void => {
   const drawFinder = (row: number, column: number): void => {
      for (let offsetRow = -1; offsetRow <= 7; offsetRow++) for (let offsetColumn = -1; offsetColumn <= 7; offsetColumn++) {
         const targetRow = row + offsetRow;
         const targetColumn = column + offsetColumn;
         if (targetRow < 0 || targetRow >= matrix.length || targetColumn < 0 || targetColumn >= matrix.length) continue;
         matrix[targetRow][targetColumn] = (offsetRow >= 0 && offsetRow <= 6 && (offsetColumn == 0 || offsetColumn == 6)) || (offsetColumn >= 0 && offsetColumn <= 6 && (offsetRow == 0 || offsetRow == 6)) || (offsetRow >= 2 && offsetRow <= 4 && offsetColumn >= 2 && offsetColumn <= 4);
      }
   };
   drawFinder(0, 0); drawFinder(matrix.length - 7, 0); drawFinder(0, matrix.length - 7);
   const positions = PATTERN_POSITION_TABLE[version - 1];
   for (const row of positions) for (const column of positions) if (matrix[row][column] == null) for (let offsetRow = -2; offsetRow <= 2; offsetRow++) for (let offsetColumn = -2; offsetColumn <= 2; offsetColumn++) matrix[row + offsetRow][column + offsetColumn] = Math.abs(offsetRow) == 2 || Math.abs(offsetColumn) == 2 || (offsetRow == 0 && offsetColumn == 0);
   for (let index = 8; index < matrix.length - 8; index++) {
      if (matrix[index][6] == null) matrix[index][6] = index % 2 == 0;
      if (matrix[6][index] == null) matrix[6][index] = index % 2 == 0;
   }
};

/** 写入格式和版本信息。 */
const setupTypeInfo = (matrix: InternalMatrix, version: number, level: ErrorCorrectLevel, mask: number, test: boolean): void => {
   const levelCode = level == "L" ? 1 : level == "Q" ? 3 : level == "H" ? 2 : 0;
   const bits = getBch((levelCode << 3) | mask, G15, 10) ^ G15_MASK;
   for (let index = 0; index < 15; index++) {
      const mod = !test && ((bits >> index) & 1) == 1;
      if (index < 6) matrix[index][8] = mod; else if (index < 8) matrix[index + 1][8] = mod; else matrix[matrix.length - 15 + index][8] = mod;
   }
   for (let index = 0; index < 15; index++) {
      const mod = !test && ((bits >> index) & 1) == 1;
      if (index < 8) matrix[8][matrix.length - index - 1] = mod; else if (index < 9) matrix[8][15 - index] = mod; else matrix[8][15 - index - 1] = mod;
   }
   matrix[matrix.length - 8][8] = !test;
   if (version < 7) return;
   const versionBits = getBch(version, G18, 12);
   for (let index = 0; index < 18; index++) {
      const mod = !test && ((versionBits >> index) & 1) == 1;
      matrix[Math.floor(index / 3)][index % 3 + matrix.length - 11] = mod;
      matrix[index % 3 + matrix.length - 11][Math.floor(index / 3)] = mod;
   }
};

/** 映射数据位。 */
const mapData = (matrix: InternalMatrix, bytes: number[], mask: number): void => {
   let row = matrix.length - 1; let direction = -1; let bitIndex = 7; let byteIndex = 0;
   for (let column = matrix.length - 1; column > 0; column -= 2) {
      if (column == 6) column--;
      while (true) {
         for (let offset = 0; offset < 2; offset++) {
            const targetColumn = column - offset;
            if (matrix[row][targetColumn] != null) continue;
            let dark = byteIndex < bytes.length && ((bytes[byteIndex] >> bitIndex) & 1) == 1;
            if (getMask(mask, row, targetColumn)) dark = !dark;
            matrix[row][targetColumn] = dark;
            bitIndex--; if (bitIndex == -1) { byteIndex++; bitIndex = 7; }
         }
         row += direction;
         if (row < 0 || row >= matrix.length) { row -= direction; direction = -direction; break; }
      }
   }
};

/** 计算掩码评分。 */
const getLostPoint = (matrix: InternalMatrix): number => {
   const size = matrix.length; let lostPoint = 0;
   for (let row = 0; row < size; row++) for (let column = 0; column < size; column++) {
      const dark = matrix[row][column] == true; let sameCount = 0;
      for (let offsetRow = -1; offsetRow <= 1; offsetRow++) for (let offsetColumn = -1; offsetColumn <= 1; offsetColumn++) {
         if (offsetRow == 0 && offsetColumn == 0) continue;
         const checkRow = row + offsetRow; const checkColumn = column + offsetColumn;
         if (checkRow >= 0 && checkRow < size && checkColumn >= 0 && checkColumn < size && dark == (matrix[checkRow][checkColumn] == true)) sameCount++;
      }
      if (sameCount > 5) lostPoint += 3 + sameCount - 5;
   }
   for (let row = 0; row < size - 1; row++) for (let column = 0; column < size - 1; column++) {
      let count = 0; if (matrix[row][column] == true) count++; if (matrix[row + 1][column] == true) count++; if (matrix[row][column + 1] == true) count++; if (matrix[row + 1][column + 1] == true) count++; if (count == 0 || count == 4) lostPoint += 3;
   }
   for (let row = 0; row < size; row++) for (let column = 0; column < size - 6; column++) if (matrix[row][column] == true && matrix[row][column + 1] == false && matrix[row][column + 2] == true && matrix[row][column + 3] == true && matrix[row][column + 4] == true && matrix[row][column + 5] == false && matrix[row][column + 6] == true) lostPoint += 40;
   for (let column = 0; column < size; column++) for (let row = 0; row < size - 6; row++) if (matrix[row][column] == true && matrix[row + 1][column] == false && matrix[row + 2][column] == true && matrix[row + 3][column] == true && matrix[row + 4][column] == true && matrix[row + 5][column] == false && matrix[row + 6][column] == true) lostPoint += 40;
   let darkCount = 0; for (const line of matrix) for (const cell of line) if (cell == true) darkCount++;
   return lostPoint + 10 * Math.abs((100 * darkCount) / size / size - 50) / 5;
};

/** 创建二维码矩阵。 */
export const createMatrix = (value: string, options: Options): Matrix => {
   const level = normalizeErrorLevel(options.errorCorrectLevel == null ? null : options.errorCorrectLevel);
   const bytes: number[] = toUtf8Bytes(value);
   let version = options.typeNumber == null ? 0 : options.typeNumber;
   if (version < 1) version = 0;
   if (version == 0) {
      for (let candidate = 1; candidate <= 40; candidate++) {
         let capacity = 0; for (const block of getRsBlocks(candidate, level)) capacity += block.dataCount;
         if (4 + (candidate < 10 ? 8 : 16) + bytes.length * 8 <= capacity * 8) { version = candidate; break; }
      }
   }
   if (version < 1 || version > 40) throw new Error("QR version must be between 1 and 40");
   const buffer = new BitBuffer(); buffer.put(MODE_8BIT_BYTE, 4); buffer.put(bytes.length, version < 10 ? 8 : 16); for (const byte of bytes) buffer.put(byte, 8);
   const data = createBytes(buffer, getRsBlocks(version, level));
   let bestMatrix: InternalMatrix | null = null; let bestLostPoint = 0;
   for (let mask = 0; mask < 8; mask++) {
      const matrix = createEmptyMatrix(version * 4 + 17); setupPatterns(matrix, version); setupTypeInfo(matrix, version, level, mask, false); mapData(matrix, data, mask); const lostPoint = getLostPoint(matrix);
      if (bestMatrix == null || lostPoint < bestLostPoint) { bestMatrix = matrix; bestLostPoint = lostPoint; }
   }
   if (bestMatrix == null) throw new Error("QR matrix generation failed");
   const cells: boolean[][] = []; for (const line of bestMatrix) { const output: boolean[] = []; for (const cell of line) output.push(cell == true); cells.push(output); }
   return { cells, size: cells.length };
};
