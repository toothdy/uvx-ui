export type Value = string | number;
export type Type = "primary" | "error" | "success" | "info" | "warning";
export type Shape = "circle" | "horn";
export type NumberType = "overflow" | "ellipsis" | "limit";

/** 徽标属性 */
export type Props = {
   isDot: boolean;
   value: Value;
   show: boolean;
   max: Value;
   type: Type;
   showZero: boolean;
   bgColor: string;
   color: string;
   shape: Shape;
   numberType: NumberType;
   offset: Value[];
   inverted: boolean;
   absolute: boolean;
   uStyle: string;
   uClass: string;
};
