<template>
   <view class="uvx-keypress"></view>
</template>

<script lang="uts" setup>
/**
 * Popup Web 键盘监听
 * @description 将常用键盘按键转换为组件事件，供 Popup 处理 Escape 关闭。
 * @property {Boolean} disable 是否禁用键盘事件，默认 false
 * @event {Function} esc 按下 Escape 时触发
 * @event {Function} tab 按下 Tab 时触发
 * @event {Function} enter 按下 Enter 时触发
 * @event {Function} space 按下空格时触发
 * @event {Function} up 按下向上键时触发
 * @event {Function} left 按下向左键时触发
 * @event {Function} right 按下向右键时触发
 * @event {Function} down 按下向下键时触发
 * @event {Function} delete 按下删除键时触发
 */

import type { KeypressProps, KeypressEmits } from "./types/index.uts";

defineOptions({ name: "uvx-popup-keypress" });

// 组件属性
const props = withDefaults(defineProps<KeypressProps>(), {
   disable: false,
});

// 组件事件
const emit = defineEmits<KeypressEmits>();

// #ifdef WEB
/**
 * 转发键盘事件
 * @param event 键盘事件
 * @returns null
 */
const handleKeyup = (event: KeyboardEvent): void => {
   if (props.disable) return;
   const key = event.key;
   if (key == "Esc" || key == "Escape") emit("esc");
   else if (key == "Tab") emit("tab");
   else if (key == "Enter") emit("enter");
   else if (key == " " || key == "Spacebar") emit("space");
   else if (key == "Up" || key == "ArrowUp") emit("up");
   else if (key == "Left" || key == "ArrowLeft") emit("left");
   else if (key == "Right" || key == "ArrowRight") emit("right");
   else if (key == "Down" || key == "ArrowDown") emit("down");
   else if (key == "Backspace" || key == "Delete" || key == "Del") emit("delete");
};

/**
 * 挂载时注册键盘监听
 * @returns null
 */
onMounted((): void => {
   document.addEventListener("keyup", handleKeyup);
});

/**
 * 卸载时移除键盘监听
 * @returns null
 */
onUnmounted((): void => {
   document.removeEventListener("keyup", handleKeyup);
});
// #endif
</script>

<style lang="scss">
// 键盘监听组件不渲染可见内容
.uvx-keypress {
   display: none;
}
</style>
