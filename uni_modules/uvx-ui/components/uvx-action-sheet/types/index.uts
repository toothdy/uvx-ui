/** ActionSheet 微信开放能力类型 */
export type OpenType = "getUserInfo" | "contact" | "getPhoneNumber"
   | "openSetting" | "launchApp" | "error" | "";

/** ActionSheet 返回用户信息的语言 */
export type Lang = "zh_CN" | "zh_TW" | "en";

/** ActionSheet 操作项 */
export type Item = {
   name: string;
   color?: string;
   fontSize?: number;
   subname?: string;
   openType?: string;
   disabled?: boolean;
   loading?: boolean;
};

/** ActionSheet 组件属性 */
export type Props = {
   title: string;
   description: string;
   actions: Item[];
   cancelText: string;
   closeOnClickAction: boolean;
   safeAreaInsetBottom: boolean;
   openType: OpenType;
   closeOnClickOverlay: boolean;
   round: number;
   lang: Lang;
   sessionFrom: string;
   sendMessageTitle: string;
   sendMessagePath: string;
   sendMessageImg: string;
   showMessageCard: boolean;
   appParameter: string;
};

/** ActionSheet 组件事件 */
export type Emits = {
   select: [item: Item];
   close: [];
   getuserinfo: [event: UniEvent];
   contact: [event: UniEvent];
   getphonenumber: [event: UniEvent];
   error: [event: UniEvent];
   launchapp: [event: UniEvent];
   opensetting: [event: UniEvent];
};
