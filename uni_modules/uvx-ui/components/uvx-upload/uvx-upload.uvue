<template>
   <view class="uvx-upload" :class="uClass" :style="$uvx.style.parse(uStyle)">
      <view class="uvx-upload__list">
         <!-- 已选文件 -->
         <view
            v-for="(item, index) in visibleFiles"
            :key="index"
            class="uvx-upload__item"
            :style="itemStyle"
         >
            <image
               v-if="isImage(item)"
               class="uvx-upload__image"
               :src="getThumb(item)"
               :mode="imageMode"
               @click="handlePreview(item, index)"
            ></image>
            <view v-else class="uvx-upload__other" @click="handlePreview(item, index)">
               <uvx-icon :name="isVideo(item) ? 'movie' : 'folder'" size="28"></uvx-icon>
               <text class="uvx-upload__other-text">{{ isVideo(item) ? t("视频") : t("文件") }}</text>
            </view>

            <!-- 上传状态 -->
            <view v-if="item.status == 'uploading' || item.status == 'failed'" class="uvx-upload__status">
               <uvx-loading-icon v-if="item.status == 'uploading'" size="22" mode="circle"></uvx-loading-icon>
               <uvx-icon v-else name="close-circle" color="#ffffff" size="24"></uvx-icon>
               <text v-if="item.message != null" class="uvx-upload__status-text">{{ item.message }}</text>
            </view>
            <view v-if="item.status == 'success'" class="uvx-upload__success">
               <view class="uvx-upload__success-icon">
                  <uvx-icon name="checkmark" color="#ffffff" size="8"></uvx-icon>
               </view>
            </view>
            <view
               v-if="item.status != 'uploading' && (deletable || item.deletable == true)"
               class="uvx-upload__delete"
               @click.stop="handleDelete(item, index)"
            >
               <view class="uvx-upload__delete-icon">
                  <uvx-icon name="close" color="#ffffff" size="8"></uvx-icon>
               </view>
            </view>
         </view>

         <!-- 选择入口 -->
         <view v-if="fileList.length < countLimit" class="uvx-upload__entry" @click="handleChoose">
            <slot>
               <view class="uvx-upload__button" :class="disabled ? 'uvx-upload__button-disabled' : ''" :style="itemStyle">
                  <uvx-icon :name="uploadIcon" :color="uploadIconColor" size="30"></uvx-icon>
                  <text v-if="!$uvx.string.empty(uploadText)" class="uvx-upload__button-text">{{ uploadText }}</text>
               </view>
            </slot>
         </view>
      </view>

      <!-- 视频预览 -->
      <uvx-popup ref="videoPopup" mode="center" :safe-area="false" bg-color="#000000" @change="handleVideoPopupChange">
         <view class="uvx-upload__video-wrap">
            <video v-if="!$uvx.string.empty(previewVideoUrl)" class="uvx-upload__video" :src="previewVideoUrl" controls autoplay></video>
            <view class="uvx-upload__video-close" @click="handleCloseVideo">
               <uvx-icon name="close" color="#ffffff" size="24"></uvx-icon>
            </view>
         </view>
      </uvx-popup>
   </view>
</template>

<script lang="uts" setup>
/**
 * uvx-upload 上传
 * @description 选择并预览图片、视频或文件；实际上传及文件列表由调用方维护。
 * @tutorial https://www.uvxui.cn/components/upload.html
 * @property {String} accept 文件类型：image、video、file、all、media（默认 image）；file、all 仅 Web 和微信可用，media 仅微信可用
 * @property {String | Array} capture 图片、视频来源：album、camera（默认 ["album", "camera"]）
 * @property {Boolean} compressed 是否压缩所选视频（默认 true）
 * @property {String} camera 视频拍摄摄像头：back、front（默认 back）
 * @property {Number} maxDuration 最长拍摄时间，单位秒（默认 60）
 * @property {String} uploadIcon 默认选择入口图标（默认 camera-fill）
 * @property {String} uploadIconColor 入口图标颜色，空值时跟随主题（默认空字符串）
 * @property {Boolean} useBeforeRead 是否通过 beforeRead 事件确认读取（默认 false）
 * @property {Function} beforeRead 读取前回调，可返回布尔值、替换文件或 Promise
 * @property {Function} afterRead 文件通过大小校验后的回调
 * @property {Boolean} previewFullImage 是否开启系统图片预览（默认 true）
 * @property {Boolean} previewFullVideo 是否开启视频弹层预览（默认 true）
 * @property {String | Number} maxCount 最大文件数量（默认 52）
 * @property {Boolean} disabled 是否禁止选择文件（默认 false）
 * @property {String} imageMode 缩略图裁剪模式（默认 aspectFill）
 * @property {String} name 事件中的列表标识（默认空字符串）
 * @property {Array} sizeType 图片尺寸类型（默认 ["original", "compressed"]）
 * @property {Boolean} multiple 是否多选图片、文件或媒体（默认 false）
 * @property {Boolean} deletable 是否显示删除按钮（默认 true）
 * @property {String | Number} maxSize 单个文件大小上限，单位字节（默认 Number.MAX_VALUE）
 * @property {Array} fileList 由调用方维护的文件列表（默认空数组）
 * @property {String} uploadText 默认选择入口文字（默认空字符串）
 * @property {String | Number} width 缩略块和默认入口宽度，数值单位 px（默认 80）
 * @property {String | Number} height 缩略块和默认入口高度，数值单位 px（默认 80）
 * @property {Boolean} previewImage 是否显示文件缩略块（默认 true）
 * @property {String} uStyle 根节点自定义样式（默认空字符串）
 * @property {String} uClass 根节点外部类名（默认空字符串）
 * @event {Function} error 文件选择失败或类型不受支持时触发
 * @event {Function} beforeRead 开启 useBeforeRead 后触发，通过 callback 确认是否继续
 * @event {Function} oversize 文件超过 maxSize 时触发
 * @event {Function} afterRead 文件通过大小校验后触发
 * @event {Function} delete 请求删除指定文件时触发
 * @event {Function} clickPreview 点击文件缩略块时触发
 * @slot default 自定义文件选择入口
 * @example <uvx-upload :file-list="files" @afterRead="handleAfterRead" @delete="handleDelete"></uvx-upload>
 */
import { $uvx } from "../../index.uts";
import { t } from "../../core/i18n";
import type { ChangeEvent } from "../uvx-popup/types/index.uts";
import type { Props, Emits, UploadFile, UploadDetail, UploadReadEvent } from "./types/index.uts";

defineOptions({ name: "uvx-upload", options: { virtualHost: true }, externalClasses: ["u-class"] });

// 组件属性及默认值
const props = withDefaults(defineProps<Props>(), {
   accept: "image",
   capture: (): string[] => ["album", "camera"],
   compressed: true,
   camera: "back",
   maxDuration: 60,
   uploadIcon: "camera-fill",
   uploadIconColor: "",
   useBeforeRead: false,
   previewFullImage: true,
   previewFullVideo: true,
   maxCount: 52,
   disabled: false,
   imageMode: "aspectFill",
   name: "",
   sizeType: (): string[] => ["original", "compressed"],
   multiple: false,
   deletable: true,
   maxSize: Number.MAX_VALUE,
   fileList: (): UploadFile[] => [],
   uploadText: "",
   width: 80,
   height: 80,
   previewImage: true,
   uStyle: "",
   uClass: "",
});

// 对外事件
const emit = defineEmits<Emits>();

// 当前预览的视频地址
const previewVideoUrl = ref("");
// 视频弹层实例
const videoPopup = ref<UvxPopupComponentPublicInstance | null>(null);
// 文件选择期间锁定入口
const isChoosing = ref(false);

/**
 * 最大文件数
 * @returns number
 */
const countLimit = computed((): number => {
   const value = Number(props.maxCount);
   return Number.isNaN(value) ? 52 : Math.max(0, Math.floor(value));
});

/**
 * 图片、视频来源配置
 * @returns string[]
 */
const sourceTypes = computed((): string[] => {
   return typeof props.capture == "string" ? props.capture.split(",") : props.capture;
});

/**
 * 需要展示的文件列表
 * @returns UploadFile[]
 */
const visibleFiles = computed((): UploadFile[] => props.previewImage ? props.fileList : []);

/**
 * 文件尺寸样式
 * @returns UTSJSONObject
 */
const itemStyle = computed((): UTSJSONObject => {
   return { width: $uvx.format.unit(props.width), height: $uvx.format.unit(props.height) };
});

/**
 * 取预览缩略图
 * @param file 文件项
 * @returns string
 */
const getThumb = (file: UploadFile): string => file.thumb != null ? file.thumb : file.url;

/**
 * 判断图片文件
 * @param file 文件项
 * @returns boolean
 */
const isImage = (file: UploadFile): boolean => {
   if (file.type == "image") return true;
   if (file.type == "video" || file.type == "file") return false;
   if (file.type != null && file.type.startsWith("image/")) return true;
   if (file.type != null && file.type.startsWith("video/")) return false;
   if (props.accept == "image") return true;
   return /\.(png|jpe?g|gif|webp|bmp)(\?|$)/i.test(getThumb(file));
};

/**
 * 判断视频文件
 * @param file 文件项
 * @returns boolean
 */
const isVideo = (file: UploadFile): boolean => {
   if (file.type == "video") return true;
   if (file.type == "image" || file.type == "file") return false;
   if (file.type != null && file.type.startsWith("video/")) return true;
   if (file.type != null && file.type.startsWith("image/")) return false;
   return props.accept == "video" || /\.(mp4|mov|m4v|webm)(\?|$)/i.test(file.url);
};

/**
 * 获取事件标识
 * @param index 文件位置
 * @returns UploadDetail
 */
const getDetail = (index: number): UploadDetail => ({ name: props.name, index });

/**
 * 文件大小校验和读取事件
 * @param files 所选文件
 * @returns null
 */
const handleAfterRead = (files: UploadFile[]): void => {
   if (files.length == 0) return;
   const file: UploadFile | UploadFile[] = props.multiple ? files : files[0];
   const detail = getDetail(props.fileList.length);
   const event: UploadReadEvent = { file, name: detail.name, index: detail.index };
   const maxSize = Number(props.maxSize);
   for (let index = 0; index < files.length; index++) {
      const size = files[index].size;
      if (size != null && size > maxSize) {
         emit("oversize", event);
         return;
      }
   }
   if (props.afterRead != null) props.afterRead(file, detail);
   emit("afterRead", event);
};

/**
 * 读取前交给调用方确认
 * @param files 所选文件
 * @returns Promise<void>
 */
const handleBeforeRead = async (files: UploadFile[]): Promise<void> => {
   if (files.length == 0) return;
   let file: UploadFile | UploadFile[] = props.multiple ? files : files[0];
   const detail = getDetail(props.fileList.length);
   if (props.beforeRead != null) {
      try {
         const result = await props.beforeRead(file, detail);
         if (typeof result == "boolean") {
            if (!result) return;
         } else {
            files = Array.isArray(result) ? result : [result];
            if (files.length == 0) return;
            file = props.multiple ? files : files[0];
         }
      } catch (error) {
         return;
      }
   }
   if (props.useBeforeRead) {
      emit("beforeRead", {
         file,
         name: detail.name,
         index: detail.index,
         callback: (accepted: boolean): void => {
            if (accepted) handleAfterRead(files);
         },
      });
      return;
   }
   handleAfterRead(files);
};

/**
 * 打开系统文件选择器
 * @returns null
 */
const handleChoose = (): void => {
   if (props.disabled || isChoosing.value || props.fileList.length >= countLimit.value) return;
   isChoosing.value = true;
   if (props.accept == "image") {
      uni.chooseImage({
         count: props.multiple ? Math.min(countLimit.value - props.fileList.length, 9) : 1,
         sourceType: sourceTypes.value,
         sizeType: props.sizeType,
         success: (result) => {
            const files: UploadFile[] = [];
            for (let index = 0; index < result.tempFiles.length; index++) {
               const item = result.tempFiles[index];
               files.push({ url: item.path, thumb: item.path, size: item.size, type: "image" });
            }
            handleBeforeRead(files);
         },
         fail: (error) => emit("error", error.errMsg),
         complete: () => { isChoosing.value = false; },
      });
      return;
   }
   if (props.accept == "video") {
      uni.chooseVideo({
         sourceType: sourceTypes.value,
         camera: props.camera,
         maxDuration: props.maxDuration,
         compressed: props.compressed,
         success: (result) => handleBeforeRead([{
            url: result.tempFilePath,
            size: result.size,
            type: "video",
         }]),
         fail: (error) => emit("error", error.errMsg),
         complete: () => { isChoosing.value = false; },
      });
      return;
   }
   // #ifdef WEB || MP-WEIXIN
   if (props.accept == "file" || props.accept == "all") {
      uni.chooseFile({
         count: props.multiple ? countLimit.value - props.fileList.length : 1,
         type: props.accept,
         success: (result) => {
            const files: UploadFile[] = [];
            for (let index = 0; index < result.tempFiles.length; index++) {
               const item = result.tempFiles[index];
               files.push({ url: item.path, name: item.name, size: item.size, type: item.type });
            }
            handleBeforeRead(files);
         },
         fail: (error) => emit("error", error.errMsg),
         complete: () => { isChoosing.value = false; },
      });
      return;
   }
   // #endif
   // #ifdef MP-WEIXIN
   if (props.accept == "media") {
      uni.chooseMedia({
         count: props.multiple ? Math.min(countLimit.value - props.fileList.length, 9) : 1,
         sourceType: sourceTypes.value,
         mediaType: ["image", "video"],
         maxDuration: props.maxDuration,
         success: (result) => {
            const files: UploadFile[] = [];
            for (let index = 0; index < result.tempFiles.length; index++) {
               const item = result.tempFiles[index];
               files.push({
                  url: item.tempFilePath,
                  thumb: item.fileType == "video" ? item.thumbTempFilePath : item.tempFilePath,
                  size: item.size,
                  type: item.fileType,
               });
            }
            handleBeforeRead(files);
         },
         fail: (error) => emit("error", error.errMsg),
         complete: () => { isChoosing.value = false; },
      });
      return;
   }
   // #endif
   isChoosing.value = false;
   emit("error", t("不支持的文件类型"));
};

/**
 * 预览文件
 * @param file 文件项
 * @param index 文件位置
 * @returns null
 */
const handlePreview = (file: UploadFile, index: number): void => {
   emit("clickPreview", { file, name: props.name, index });
   if (isImage(file) && props.previewFullImage) {
      const urls: string[] = [];
      let current = 0;
      for (let itemIndex = 0; itemIndex < props.fileList.length; itemIndex++) {
         const item = props.fileList[itemIndex];
         if (isImage(item)) {
            if (itemIndex == index) current = urls.length;
            urls.push(item.url);
         }
      }
      if (urls.length > 0) uni.previewImage({ urls, current });
   } else if (isVideo(file) && props.previewFullVideo) {
      previewVideoUrl.value = file.url;
      videoPopup.value?.open();
   }
};

/**
 * 请求删除文件
 * @param file 文件项
 * @param index 文件位置
 * @returns null
 */
const handleDelete = (file: UploadFile, index: number): void => {
   emit("delete", { file, name: props.name, index });
};

/**
 * 关闭视频预览
 * @returns null
 */
const handleCloseVideo = (): void => {
   previewVideoUrl.value = "";
   videoPopup.value?.close();
};

/**
 * 弹层关闭后停止视频播放
 * @param event 弹层变化事件
 * @returns null
 */
const handleVideoPopupChange = (event: ChangeEvent): void => {
   if (!event.show) previewVideoUrl.value = "";
};
</script>

<style lang="scss">
// 上传容器
.uvx-upload {
   overflow: visible;
}

// 文件列表
.uvx-upload__list {
   flex-direction: row;
   flex-wrap: wrap;
   overflow: visible;
}

// 文件缩略块
.uvx-upload__item {
   position: relative;
   margin: 0 8px 8px 0;
   border-radius: 4px;
   overflow: hidden;
   background-color: var(--uvx-container);
}

// 图片缩略图
.uvx-upload__image {
   width: 100%;
   height: 100%;
}

// 视频或文件占位
.uvx-upload__other {
   width: 100%;
   height: 100%;
   align-items: center;
   justify-content: center;
}

// 文件类型文字
.uvx-upload__other-text {
   margin-top: 2px;
   font-size: 11px;
   line-height: 1.2em;
   color: var(--uvx-text-tips);
}

// 上传状态遮罩
.uvx-upload__status {
   position: absolute;
   top: 0;
   right: 0;
   bottom: 0;
   left: 0;
   align-items: center;
   justify-content: center;
   background-color: rgba(0, 0, 0, 0.5);
}

// 上传状态文字
.uvx-upload__status-text {
   margin-top: 5px;
   font-size: 12px;
   line-height: 1.2em;
   color: #ffffff;
}

// 删除按钮
.uvx-upload__delete {
   position: absolute;
   top: 0;
   right: 0;
   width: 14px;
   height: 14px;
   border-bottom-left-radius: 100px;
   background-color: var(--uvx-error);
}

// 删除角标右上角图标
.uvx-upload__delete-icon {
   position: absolute;
   top: 0;
   right: 0;
   width: 11px;
   height: 11px;
   align-items: center;
   justify-content: center;
}

// 上传成功标记
.uvx-upload__success {
   position: absolute;
   right: 0;
   bottom: 0;
   width: 0;
   height: 0;
   overflow: visible;
   border-width: 7px;
   border-style: solid;
   border-top-color: transparent;
   border-left-color: transparent;
   border-right-color: var(--uvx-success);
   border-bottom-color: var(--uvx-success);
}

// 三角角标中的勾选图标
.uvx-upload__success-icon {
   position: absolute;
   right: -7px;
   bottom: -7px;
   display: flex;
   align-items: center;
   justify-content: center;
   width: 8px;
   height: 8px;
}

// 文件选择入口
.uvx-upload__entry {
   margin: 0 8px 8px 0;
}

// 默认选择按钮
.uvx-upload__button {
   align-items: center;
   justify-content: center;
   border-radius: 4px;
   background-color: var(--uvx-container);
}

// 禁用时的按钮
.uvx-upload__button-disabled {
   opacity: 0.5;
}

// 选择入口文字
.uvx-upload__button-text {
   margin-top: 2px;
   font-size: 11px;
   line-height: 1.2em;
   color: var(--uvx-text-tips);
}

// 视频预览容器
.uvx-upload__video-wrap {
   width: 100%;
   background-color: #000000;
}

// 视频播放器
.uvx-upload__video {
   width: 100%;
   height: 240px;
}

// 视频关闭按钮
.uvx-upload__video-close {
   position: absolute;
   top: 0;
   right: 0;
   width: 40px;
   height: 40px;
   align-items: center;
   justify-content: center;
}
</style>
