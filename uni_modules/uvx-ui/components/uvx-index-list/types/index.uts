import type { ComponentPublicInstance } from "vue";

/** 索引值 */
export type Value = string | number;

/** 索引列表属性 */
export type Props = {
   /** 非激活索引颜色，空值时跟随主题 */
   inactiveColor: string;
   /** 激活索引颜色，空值时跟随主题 */
   activeColor: string;
   /** 索引字符列表，为空时使用 A-Z */
   indexList: Value[];
   /** 自定义导航栏高度 */
   customNavHeight: string | number;
   /** 根节点自定义样式 */
   uStyle: string;
   /** 根节点自定义类名 */
   uClass: string;
};

/** 索引列表事件 */
export type Emits = {
   select: [index: number, value: Value];
};

/** 分组布局信息 */
export type ItemLayout = {
   top: number;
   height: number;
   isReady: boolean;
};

/** 索引列表组件上下文 */
export type Context = {
   register: (child: ComponentPublicInstance) => void;
   unregister: (child: ComponentPublicInstance) => void;
   updateLayout: (child: ComponentPublicInstance, top: number, height: number) => void;
};
