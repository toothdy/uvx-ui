import type { LunarInfo } from "./types/index.uts";

// 1900 至 2100 年农历大小月及闰月数据
const YEAR_DATA: number[] = [
   0x04bd8, 0x04ae0, 0x0a570, 0x054d5, 0x0d260, 0x0d950, 0x16554, 0x056a0, 0x09ad0, 0x055d2,
   0x04ae0, 0x0a5b6, 0x0a4d0, 0x0d250, 0x1d255, 0x0b540, 0x0d6a0, 0x0ada2, 0x095b0, 0x14977,
   0x04970, 0x0a4b0, 0x0b4b5, 0x06a50, 0x06d40, 0x1ab54, 0x02b60, 0x09570, 0x052f2, 0x04970,
   0x06566, 0x0d4a0, 0x0ea50, 0x06e95, 0x05ad0, 0x02b60, 0x186e3, 0x092e0, 0x1c8d7, 0x0c950,
   0x0d4a0, 0x1d8a6, 0x0b550, 0x056a0, 0x1a5b4, 0x025d0, 0x092d0, 0x0d2b2, 0x0a950, 0x0b557,
   0x06ca0, 0x0b550, 0x15355, 0x04da0, 0x0a5b0, 0x14573, 0x052b0, 0x0a9a8, 0x0e950, 0x06aa0,
   0x0aea6, 0x0ab50, 0x04b60, 0x0aae4, 0x0a570, 0x05260, 0x0f263, 0x0d950, 0x05b57, 0x056a0,
   0x096d0, 0x04dd5, 0x04ad0, 0x0a4d0, 0x0d4d4, 0x0d250, 0x0d558, 0x0b540, 0x0b6a0, 0x195a6,
   0x095b0, 0x049b0, 0x0a974, 0x0a4b0, 0x0b27a, 0x06a50, 0x06d40, 0x0af46, 0x0ab60, 0x09570,
   0x04af5, 0x04970, 0x064b0, 0x074a3, 0x0ea50, 0x06b58, 0x05ac0, 0x0ab60, 0x096d5, 0x092e0,
   0x0c960, 0x0d954, 0x0d4a0, 0x0da50, 0x07552, 0x056a0, 0x0abb7, 0x025d0, 0x092d0, 0x0cab5,
   0x0a950, 0x0b4a0, 0x0baa4, 0x0ad50, 0x055d9, 0x04ba0, 0x0a5b0, 0x15176, 0x052b0, 0x0a930,
   0x07954, 0x06aa0, 0x0ad50, 0x05b52, 0x04b60, 0x0a6e6, 0x0a4e0, 0x0d260, 0x0ea65, 0x0d530,
   0x05aa0, 0x076a3, 0x096d0, 0x04afb, 0x04ad0, 0x0a4d0, 0x1d0b6, 0x0d250, 0x0d520, 0x0dd45,
   0x0b5a0, 0x056d0, 0x055b2, 0x049b0, 0x0a577, 0x0a4b0, 0x0aa50, 0x1b255, 0x06d20, 0x0ada0,
   0x14b63, 0x09370, 0x049f8, 0x04970, 0x064b0, 0x168a6, 0x0ea50, 0x06b20, 0x1a6c4, 0x0aae0,
   0x0a2e0, 0x0d2e3, 0x0c960, 0x0d557, 0x0d4a0, 0x0da50, 0x05d55, 0x056a0, 0x0a6d0, 0x055d4,
   0x052d0, 0x0a9b8, 0x0a950, 0x0b4a0, 0x0b6a6, 0x0ad50, 0x055a0, 0x0aba4, 0x0a5b0, 0x052b0,
   0x0b273, 0x06930, 0x07337, 0x06aa0, 0x0ad50, 0x14b55, 0x04b60, 0x0a570, 0x054e4, 0x0d160,
   0x0e968, 0x0d520, 0x0daa0, 0x16aa6, 0x056d0, 0x04ae0, 0x0a9d4, 0x0a2d0, 0x0d150, 0x0f252,
   0x0d520,
];
const MONTH_NAMES: string[] = ["正", "二", "三", "四", "五", "六", "七", "八", "九", "十", "冬", "腊"];
const DAY_PREFIXES: string[] = ["初", "十", "廿", "卅"];
const DAY_NUMBERS: string[] = ["日", "一", "二", "三", "四", "五", "六", "七", "八", "九", "十"];
const BASE_UTC = Date.UTC(1900, 0, 31);
const DAY_MS = 86400000;

/**
 * 获取空农历信息
 * @returns LunarInfo
 */
export const getEmptyInfo = (): LunarInfo => {
   return {
      lYear: 0,
      lMonth: 0,
      lDay: 0,
      IMonthCn: "",
      IDayCn: "",
      isLeap: false,
   };
};

/**
 * 获取指定农历年的数据
 * @param year 农历年
 * @returns number
 */
const getYearInfo = (year: number): number => {
   const index = year - 1900;
   if (index < 0 || index >= YEAR_DATA.length) return 0;
   return YEAR_DATA[index];
};

/**
 * 获取闰月月份
 * @param year 农历年
 * @returns number
 */
const getLeapMonth = (year: number): number => {
   return getYearInfo(year) & 0x0f;
};

/**
 * 获取闰月天数
 * @param year 农历年
 * @returns number
 */
const getLeapMonthDays = (year: number): number => {
   if (getLeapMonth(year) == 0) return 0;
   return (getYearInfo(year) & 0x10000) != 0 ? 30 : 29;
};

/**
 * 获取普通农历月天数
 * @param year 农历年
 * @param month 农历月
 * @returns number
 */
const getMonthDays = (year: number, month: number): number => {
   if (month < 1 || month > 12) return 0;
   return (getYearInfo(year) & (0x10000 >> month)) != 0 ? 30 : 29;
};

/**
 * 获取农历年总天数
 * @param year 农历年
 * @returns number
 */
const getYearDays = (year: number): number => {
   let days = 348;
   const info = getYearInfo(year);
   for (let mask = 0x8000; mask > 0x8; mask >>= 1) {
      if ((info & mask) != 0) days++;
   }
   return days + getLeapMonthDays(year);
};

/**
 * 获取农历月份中文
 * @param month 农历月
 * @param isLeap 是否闰月
 * @returns string
 */
const getMonthText = (month: number, isLeap: boolean): string => {
   const index = month - 1;
   if (index < 0 || index >= MONTH_NAMES.length) return "";
   return `${isLeap ? "闰" : ""}${MONTH_NAMES[index]}月`;
};

/**
 * 获取农历日期中文
 * @param day 农历日
 * @returns string
 */
const getDayText = (day: number): string => {
   if (day < 1 || day > 30) return "";
   if (day == 10) return "初十";
   if (day == 20) return "二十";
   if (day == 30) return "三十";
   const prefixIndex = Math.floor(day / 10);
   const numberIndex = day % 10;
   if (prefixIndex < 0 || prefixIndex >= DAY_PREFIXES.length) return "";
   if (numberIndex < 0 || numberIndex >= DAY_NUMBERS.length) return "";
   return DAY_PREFIXES[prefixIndex] + DAY_NUMBERS[numberIndex];
};

/**
 * 公历日期转换为农历
 * @param year 公历年
 * @param month 公历月
 * @param day 公历日
 * @returns LunarInfo
 */
export const getInfo = (year: number, month: number, day: number): LunarInfo => {
   if (year < 1900 || year > 2100) return getEmptyInfo();
   const targetUtc = Date.UTC(year, month - 1, day);
   let offset = Math.floor((targetUtc - BASE_UTC) / DAY_MS);
   if (offset < 0) return getEmptyInfo();

   let lunarYear = 1900;
   while (lunarYear <= 2100) {
      const yearDays = getYearDays(lunarYear);
      if (offset < yearDays) break;
      offset -= yearDays;
      lunarYear++;
   }
   if (lunarYear > 2100) return getEmptyInfo();

   const leapMonth = getLeapMonth(lunarYear);
   let lunarMonth = 1;
   let isLeap = false;
   while (lunarMonth <= 12) {
      const monthDays = isLeap
         ? getLeapMonthDays(lunarYear)
         : getMonthDays(lunarYear, lunarMonth);
      if (offset < monthDays) break;
      offset -= monthDays;
      if (leapMonth > 0 && lunarMonth == leapMonth) {
         if (isLeap) {
            isLeap = false;
            lunarMonth++;
         } else {
            isLeap = true;
         }
      } else {
         lunarMonth++;
      }
   }

   const lunarDay = offset + 1;
   return {
      lYear: lunarYear,
      lMonth: lunarMonth,
      lDay: lunarDay,
      IMonthCn: getMonthText(lunarMonth, isLeap),
      IDayCn: getDayText(lunarDay),
      isLeap: isLeap,
   };
};
