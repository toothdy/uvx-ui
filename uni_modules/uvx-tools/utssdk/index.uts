import { AnimationCallback, OpenSystemSettings, StopAnimation } from "./interface.uts";
import { startTimerAnimation, stopTimerAnimation } from "./common/animation.uts";

/**
 * 启动通用定时器动画
 * @param animationId 动画标识
 * @param callback 动画回调
 * @returns null
 */
@UTSJS.keepAlive
export function startAnimation(
   animationId: number,
   callback: AnimationCallback,
): void {
   startTimerAnimation(animationId, callback);
}

/**
 * 停止通用定时器动画
 * @param animationId 动画标识
 * @returns null
 */
export const stopAnimation: StopAnimation = function (
   animationId: number,
): void {
   stopTimerAnimation(animationId);
};

/**
 * 非 APP 平台无需打开系统设置
 * @returns null
 */
export const openSystemSettings: OpenSystemSettings = (): void => {};
